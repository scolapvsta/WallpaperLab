@@ -0,0 +1,35 @@
+#pragma once
+#include <nlohmann/json.hpp>
+#include <set>
+#include <string>
+
+namespace WallpaperEngine::Render::Helpers {
+// The predicate preserves the detector's focus and application exclusion policy.
+template<class Relevant>
+bool visibleFullscreen(const nlohmann::json& monitors, const nlohmann::json& clients,
+                       const std::set<std::string>& outputs, Relevant relevant) {
+    bool anyCovered = false;
+    for (const auto& monitor : monitors) {
+        const auto name = monitor.value("name", std::string());
+        if (!outputs.empty() && !outputs.contains(name)) continue;
+        bool covered = false;
+        for (const auto& client : clients) {
+            if (!client.value("mapped", false) || client.value("hidden", false)
+                || client.value("fullscreen", 0) != 2
+                || client.value("monitor", -1) != monitor.value("id", -2)
+                || !relevant(client.value("focusHistoryID", -1) == 0,
+                             client.value("class", std::string()))) continue;
+            const auto workspace = client.at("workspace").value("name", std::string());
+            for (const char* key : {"activeWorkspace", "specialWorkspace"}) {
+                const auto it = monitor.find(key);
+                if (it != monitor.end() && it->is_object()
+                    && !workspace.empty() && it->value("name", std::string()) == workspace)
+                    covered = true;
+            }
+        }
+        if (!outputs.empty() && !covered) return false;
+        anyCovered = anyCovered || covered;
+    }
+    return anyCovered;
+}
+}
