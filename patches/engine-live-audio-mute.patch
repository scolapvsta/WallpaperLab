+void CWeb::syncAudio () {
+    // Browser output bypasses SDL. Enforce both audio gates for media elements,
+    // Web Audio and iframes, including while visual rendering is paused.
+    const auto& audio = this->getContext ().getApp ().getContext ().state.audio;
+    const bool muted = !audio.enabled || audio.volume == 0;
+    if (this->m_browser && this->m_browser->GetHost ()->IsAudioMuted () != muted)
+        this->m_browser->GetHost ()->SetAudioMuted (muted);
+}
