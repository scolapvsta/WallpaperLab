+std::set<std::string> WaylandFullScreenDetector::requestedOutputs () const {
+    const auto& settings = getApplicationContext ().settings.general;
+    std::set<std::string> outputs;
+    for (const auto& screen : settings.screenBackgrounds | std::views::keys) {
+	outputs.insert (screen);
+    }
+    for (const auto& group : settings.spanGroups) {
+	outputs.insert (group.screens.begin (), group.screens.end ());
+    }
+    return outputs;
+}
+
 bool WaylandFullScreenDetector::anythingFullscreen () const {
     if (!m_toplevelManager) {
 	return false;
     }
     wl_display_roundtrip (m_display);
-    return m_fullscreenCount > 0;
+    if (m_fullscreenCount == 0) {
+	return false;
+    }
+
+    // foreign-toplevel reports fullscreen state but not where it is visible; Hyprland IPC adds it
+    if (const auto now = std::chrono::steady_clock::now (); now - m_visibleCheck >= std::chrono::milliseconds (500)) {
+	m_visibleCheck = now;
+	m_visibleFullscreen = hyprlandOutputsCovered (requestedOutputs ()).value_or (true);
+    }
+    return m_visibleFullscreen;
 }
 
