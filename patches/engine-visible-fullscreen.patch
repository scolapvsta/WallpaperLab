+    std::optional<nlohmann::json> hyprlandQuery (const char* request) {
+	const char* signature = std::getenv ("HYPRLAND_INSTANCE_SIGNATURE");
+	const char* runtime = std::getenv ("XDG_RUNTIME_DIR");
+	if (!signature || !runtime) {
+	    return std::nullopt;
+	}
+
+	const std::string socketPath = std::string (runtime) + "/hypr/" + signature + "/.socket.sock";
+	sockaddr_un addr {};
+	addr.sun_family = AF_UNIX;
+	if (socketPath.size () >= sizeof (addr.sun_path)) {
+	    return std::nullopt;
+	}
+	std::strncpy (addr.sun_path, socketPath.c_str (), sizeof (addr.sun_path) - 1);
+
+	const int fd = socket (AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (fd < 0) {
+	    return std::nullopt;
+	}
+
+	timeval timeout { .tv_sec = 0, .tv_usec = 50000 };
+	setsockopt (fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof (timeout));
+	setsockopt (fd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof (timeout));
+
+	std::string response;
+	if (connect (fd, reinterpret_cast<sockaddr*> (&addr), sizeof (addr)) == 0
+	    && send (fd, request, std::strlen (request), MSG_NOSIGNAL) >= 0) {
+	    char buffer[4096];
+	    ssize_t readBytes;
+	    while ((readBytes = recv (fd, buffer, sizeof (buffer), 0)) > 0) {
+		response.append (buffer, static_cast<std::size_t> (readBytes));
+	    }
+	}
+	close (fd);
+
+	auto json = nlohmann::json::parse (response, nullptr, false);
+	if (json.is_discarded ()) {
+	    return std::nullopt;
+	}
+	return json;
+    }
+
+    /**
+     * Whether every output in `outputs` shows a workspace with a fullscreen window. An empty set
+     * means any output. Workspaces are matched by name, the only key special workspaces expose.
+     * Returns nullopt when Hyprland IPC is unavailable.
+     */
+    std::optional<bool> hyprlandOutputsCovered (const std::set<std::string>& outputs) {
+	const auto monitors = hyprlandQuery ("j/monitors");
+	const auto workspaces = monitors ? hyprlandQuery ("j/workspaces") : std::nullopt;
+	if (!monitors || !workspaces || !monitors->is_array () || !workspaces->is_array ()) {
+	    return std::nullopt;
+	}
+
+	std::set<std::string> fullscreen;
+	for (const auto& workspace : *workspaces) {
+	    if (workspace.value ("hasfullscreen", false)) {
+		fullscreen.insert (workspace.value ("name", std::string ()));
+	    }
+	}
+
+	bool anyCovered = false;
+	for (const auto& monitor : *monitors) {
+	    const auto name = monitor.value ("name", std::string ());
+	    if (!outputs.empty () && !outputs.contains (name)) {
+		continue;
+	    }
+
+	    bool covered = false;
+	    for (const char* key : { "activeWorkspace", "specialWorkspace" }) {
+		if (const auto it = monitor.find (key); it != monitor.end () && it->is_object ()) {
+		    const auto workspace = it->value ("name", std::string ());
+		    covered = covered || (!workspace.empty () && fullscreen.contains (workspace));
+		}
+	    }
+
+	    if (!outputs.empty () && !covered) {
+		return false;
+	    }
+	    anyCovered = anyCovered || covered;
+	}
+	return anyCovered;
+    }
