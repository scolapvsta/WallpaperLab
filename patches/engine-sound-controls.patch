+        if(auto* scripted=dynamic_cast<WallpaperEngine::Scripting::ScriptableObject*>(child))JS_SetPropertyUint32(ctx,result,n++,c->adapter.instantiate(*scripted));
+    }return result;
+}
+static JSValue sound_command (JSContext* ctx, JSValueConst self, int, JSValueConst*, int magic) {
+    JSClassID id=0;auto* c=static_cast<OpaqueScriptableObjectAdapter*>(JS_GetAnyOpaque(self,&id));
+    auto* sound=c&&c->magic==SCRIPTABLE_OPAQUE_MAGIC?dynamic_cast<WallpaperEngine::Render::Objects::CSound*>(&c->object):nullptr;
+    if(!sound)return JS_UNDEFINED;
+    try{if(magic==0)sound->play();else if(magic==1)sound->pause();else if(magic==2)sound->stop();else return JS_NewBool(ctx,sound->isPlaying());}
+    catch(const std::exception& e){return JS_ThrowInternalError(ctx,"%s",e.what());}return JS_UNDEFINED;
+}
+
+static JSValue animation_command(JSContext* ctx,JSValueConst,int argc,JSValueConst* argv,int magic,JSValue* data){
+    JSClassID id=0;auto* c=static_cast<OpaqueScriptableObjectAdapter*>(JS_GetAnyOpaque(data[0],&id));
+    auto* image=c&&c->magic==SCRIPTABLE_OPAQUE_MAGIC?dynamic_cast<WallpaperEngine::Render::Objects::CImage*>(&c->object):nullptr;
+    if(!image)return JS_UNDEFINED;
+    if(magic==0)image->animationPlay();else if(magic==1)image->animationPause();else if(magic==2)image->animationStop();
+    else if(magic==3){int frame=0;if(argc)JS_ToInt32(ctx,&frame,argv[0]);image->animationSetFrame(frame);}
+    else if(magic==4)return JS_NewInt32(ctx,image->animationFrame());else return JS_NewBool(ctx,image->animationPlaying());
+    return JS_UNDEFINED;
+}
+static JSValue get_animation(JSContext* ctx,JSValueConst self,int,JSValueConst*){
+    JSValue object=JS_NewObject(ctx);const char* methods[]={"play","pause","stop","setFrame","getFrame","isPlaying"};JSValue data[]={self};
+    for(int n=0;n<6;n++)JS_SetPropertyStr(ctx,object,methods[n],JS_NewCFunctionData(ctx,animation_command,n==3?1:0,n,1,data));
+    return object;
+}
