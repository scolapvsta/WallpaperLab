@@ -0,0 +1,19 @@
+#pragma once
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <cmath>
+#include <stdexcept>
+namespace WallpaperEngine::Render::Helpers::WallpaperPlacement {
+struct Position {float x=0,y=0;};
+inline Position parse(const std::string& raw){
+    auto j=nlohmann::json::parse(raw);
+    if(!j.is_object()||!j.contains("x")||!j.contains("y")||!j["x"].is_number()||!j["y"].is_number())throw std::runtime_error("Invalid wallpaper position");
+    double x=j["x"],y=j["y"];
+    if(!std::isfinite(x)||!std::isfinite(y)||std::abs(x)>1||std::abs(y)>1)throw std::runtime_error("Wallpaper position outside [-1, 1]");
+    return {static_cast<float>(x),static_cast<float>(y)};
+}
+inline const Position& configured(){static const Position value=[](){auto raw=std::getenv("WALLPAPER_LAB_POSITION");return raw&&*raw?parse(raw):Position{};}();return value;}
+// Positive means move the image right/down, sampling an earlier source area.
+// Use the complete canvas UV range, never the individual monitor slice range.
+inline float shift(float range,float offset){return -range*offset*0.5f;}
+}
