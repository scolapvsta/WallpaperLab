+#pragma once
+#define LAB_TRANSITION_FRAGMENT "#version 330 core\n" \
+"in vec2 uv;out vec4 color;uniform sampler2D previousImage,currentImage;uniform float progress;uniform int effect;uniform vec2 origin,aspect;\n" \
+"void main(){float t=smoothstep(0.,1.,progress);vec4 a=texture(previousImage,vec2(uv.x,1.-uv.y)),b=texture(currentImage,uv);color=mix(a,b,t);" \
+"if(effect==2)color=t<.5?a*(1.-t*2.):b*(t*2.-1.);" \
+"if(effect==3)color=mix(a,texture(currentImage,(uv-.5)/(.6+.4*t)+.5),t);" \
+"if(effect==4)color=mix(texture(previousImage,vec2(((uv-.5)/(1.-.35*t)+.5).x,1.-((uv-.5)/(1.-.35*t)+.5).y)),b,t);" \
+"if(effect==5){vec2 q=uv-vec2(1.-t,0);color=q.x>=0.?texture(currentImage,q):a;}" \
+"if(effect==6)color=uv.x<t?b:a;" \
+"float r=length((uv-origin)*aspect),radius=length(aspect);" \
+"if(effect==7)color=r<t*radius?b:a;" \
+"if(effect==8)color=t<.5?(r<(1.-t*2.)*radius?a:vec4(0,0,0,1)):(r<(t*2.-1.)*radius?b:vec4(0,0,0,1));color.a=1.;}"
