+++ b/src/WallpaperEngine/Render/Shaders/TexCoordCompatibility.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <regex>
+#include <string>
+#include <vector>
+
+namespace WallpaperEngine::Render::Shaders {
+inline std::string narrowTexCoordExpressions (std::string source) {
+    const std::regex texCoordBeforeCast2 (R"(\bv_TexCoord\b(\s*[-+*/]\s*CAST2\s*\())");
+    const std::regex cast2BeforeTexCoord (R"((CAST2\s*\([^)]+\)\s*[-+*/]\s*)\bv_TexCoord\b)");
+
+    const std::regex wideTexCoordDecl (R"(\bvarying\s+vec[34]\s+v_TexCoord\s*;)");
+    if (!std::regex_search (source, wideTexCoordDecl)) {
+        return source;
+    }
+
+    source = std::regex_replace (source, texCoordBeforeCast2, "v_TexCoord.xy$1");
+    source = std::regex_replace (source, cast2BeforeTexCoord, "$1v_TexCoord.xy");
+
+    // Workshop clipping masks compute vec2 UVs from a wide varying. HLSL
+    // truncates that expression; GLSL requires the narrowing before arithmetic.
+    // Restrict this to vec2 initializers containing a declared vec2 operand,
+    // preserving wide coordinates and explicit swizzles in all other code.
+    const std::regex vec2Declaration (R"(\b(?:uniform\s+)?vec2\s+([A-Za-z_][A-Za-z0-9_]*)\s*[;=])");
+    std::vector<std::string> vec2Names;
+    for (auto it = std::sregex_iterator (source.begin (), source.end (), vec2Declaration);
+         it != std::sregex_iterator (); ++it) {
+        vec2Names.push_back ((*it)[1].str ());
+    }
+    const std::regex initializer (R"((\bvec2\s+[A-Za-z_][A-Za-z0-9_]*\s*=)([^;]+);)");
+    const std::regex bareTexCoord (R"(\bv_TexCoord\b(?!\s*\.))");
+    std::string rewritten;
+    size_t offset = 0;
+    for (auto it = std::sregex_iterator (source.begin (), source.end (), initializer);
+         it != std::sregex_iterator (); ++it) {
+        const auto& match = *it;
+        std::string expression = match[2].str ();
+        bool vec2Operand = false;
+        for (const auto& name : vec2Names) {
+            if (std::regex_search (expression, std::regex ("\\b" + name + "\\b"))) {
+                vec2Operand = true;
+                break;
+            }
+        }
+        rewritten += source.substr (offset, match.position () - offset);
+        rewritten += match[1].str () + (vec2Operand ? std::regex_replace (expression, bareTexCoord, "v_TexCoord.xy") : expression) + ";";
+        offset = match.position () + match.length ();
+    }
+    rewritten += source.substr (offset);
+    source = std::move (rewritten);
+
+    return source;
+}
+}
