--- /dev/null
+++ b/src/WallpaperEngine/Render/Helpers/LoginOverlay.h
@@ -0,0 +1,15 @@
+#pragma once
+// Optional application-owned native login overlay. No dependency in upstream tools.
+extern "C" {
+int wallpaper_lab_login_active() __attribute__((weak));
+void wallpaper_lab_login_draw(const char*,int,int,int,int) __attribute__((weak));
+void wallpaper_lab_login_pointer(const char*,double,double,int) __attribute__((weak));
+void wallpaper_lab_login_keymap(int,unsigned int) __attribute__((weak));
+void wallpaper_lab_login_key(unsigned int,unsigned int) __attribute__((weak));
+void wallpaper_lab_login_modifiers(unsigned int,unsigned int,unsigned int,unsigned int) __attribute__((weak));
+void wallpaper_lab_login_symbol(unsigned int) __attribute__((weak));
+void wallpaper_lab_login_text(unsigned int) __attribute__((weak));
+int wallpaper_lab_login_paused() __attribute__((weak));
+float wallpaper_lab_login_time(float) __attribute__((weak));
+}
+inline bool labLoginActive(){return wallpaper_lab_login_active && wallpaper_lab_login_active();}
