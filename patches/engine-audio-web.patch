+
+void SubprocessApp::OnContextCreated (CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame,
+                                      CefRefPtr<CefV8Context> context) {
+    if (!frame->IsMain ()) return;
+    // Install before any wallpaper script runs, including inline scripts.
+    CefRefPtr<CefV8Value> result;
+    CefRefPtr<CefV8Exception> error;
+    context->Eval (R"JS((() => {
+        let listener = null;
+        window.wallpaperRegisterAudioListener = callback => {
+            if (typeof callback !== 'function') throw new TypeError('Expected an audio callback');
+            listener = callback;
+        };
+        Object.defineProperty(window, '__wallpaperLabAudio', {
+            value: data => { if (listener) listener(data); }
+        });
+    })())JS", frame->GetURL (), 1, result, error);
+}
+
+bool SubprocessApp::OnProcessMessageReceived (CefRefPtr<CefBrowser>, CefRefPtr<CefFrame> frame,
+                                              CefProcessId source, CefRefPtr<CefProcessMessage> message) {
+    if (source != PID_BROWSER || message->GetName () != "wallpaper-lab-audio") return false;
+    auto context = frame->GetV8Context ();
+    if (!context || !context->Enter ()) return true;
+    auto global = context->GetGlobal ();
+    auto callback = global->GetValue ("__wallpaperLabAudio");
+    auto values = message->GetArgumentList ();
+    if (callback && callback->IsFunction () && values->GetSize () == 128) {
+        auto data = CefV8Value::CreateArray (128);
+        for (int i = 0; i < 128; ++i) data->SetValue (i, CefV8Value::CreateDouble (values->GetDouble (i)));
+        callback->ExecuteFunction (global, { data });
+    }
+    context->Exit ();
+    return true;
+}
