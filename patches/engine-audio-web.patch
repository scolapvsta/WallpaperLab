+JSValue EngineObject::registerAudioBuffers (int resolution) {
+    auto* context = m_engine.getContext ();
+    if (resolution != 16 && resolution != 32 && resolution != 64)
+        return JS_ThrowRangeError (context, "Audio resolution must be 16, 32 or 64");
+    if (!m_audioBuffers.contains (resolution)) {
+        auto buffer = JS_NewObject (context);
+        auto global = JS_GetGlobalObject (context);
+        auto constructor = JS_GetPropertyStr (context, global, "Float32Array");
+        JSValue size = JS_NewInt32 (context, resolution);
+        for (const auto* name : { "left", "right", "average" })
+            JS_SetPropertyStr (context, buffer, name, JS_CallConstructor (context, constructor, 1, &size));
+        JS_FreeValue (context, constructor);
+        JS_FreeValue (context, global);
+        m_audioBuffers.emplace (resolution, buffer);
+    }
+    return JS_DupValue (context, m_audioBuffers.at (resolution));
+}
+
 void EngineObject::tick () {
+    auto* context = m_engine.getContext ();
+    const auto& recorder = m_scene.getAudioContext ().getRecorder ();
+    for (const auto& [resolution, buffer] : m_audioBuffers) {
+        auto left = JS_GetPropertyStr (context, buffer, "left");
+        auto right = JS_GetPropertyStr (context, buffer, "right");
+        auto average = JS_GetPropertyStr (context, buffer, "average");
+        const float* l = resolution == 16 ? recorder.audio16 : resolution == 32 ? recorder.audio32 : recorder.audio64;
+        const float* r = resolution == 16 ? recorder.audio16Right : resolution == 32 ? recorder.audio32Right : recorder.audio64Right;
+        for (int i = 0; i < resolution; ++i) {
+            JS_SetPropertyUint32 (context, left, i, JS_NewFloat64 (context, l[i]));
+            JS_SetPropertyUint32 (context, right, i, JS_NewFloat64 (context, r[i]));
+            JS_SetPropertyUint32 (context, average, i, JS_NewFloat64 (context, (l[i] + r[i]) * 0.5));
+        }
+        JS_FreeValue (context, left); JS_FreeValue (context, right); JS_FreeValue (context, average);
+    }
+
     const auto now = std::chrono::steady_clock::now ();
 
     // check any interval and run them if needed
