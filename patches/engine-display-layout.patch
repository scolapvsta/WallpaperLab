+                out << "P6\n" << width << " " << height << "\n255\n";
+                for (int row = height-1; row >= 0; --row) out.write (reinterpret_cast<const char*>(pixels.data ()+size_t(row)*width*3), width*3);
+                captured.insert (viewport->name);
+            }
+        }
+    }
