diff --git a/src/WallpaperEngine/Render/Helpers/SpanGeometry.h b/src/WallpaperEngine/Render/Helpers/SpanGeometry.h
new file mode 100644
--- /dev/null
+++ b/src/WallpaperEngine/Render/Helpers/SpanGeometry.h
@@ -0,0 +1,37 @@
+#pragma once
+#include <glm/vec4.hpp>
+#include <glm/vec2.hpp>
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <algorithm>
+#include <map>
+#include <stdexcept>
+#include <string>
+namespace WallpaperEngine::Render::Helpers::SpanGeometry {
+using Rects=std::map<std::string,glm::ivec4>;
+inline Rects parse(const std::string& text){
+    auto data=nlohmann::json::parse(text);
+    if(!data.is_object()||data.empty()||data.size()>32)throw std::runtime_error("Invalid span calibration");
+    Rects result;
+    for(auto& [name,value]:data.items()){
+        if(name.empty()||name.size()>128||!value.is_array()||value.size()!=4)throw std::runtime_error("Invalid span output rectangle");
+        glm::ivec4 r;
+        for(int i=0;i<4;i++){
+            if(!value[i].is_number_integer())throw std::runtime_error("Span calibration must use integer coordinates");
+            auto n=value[i].get<int64_t>();if(n<0||n>16384)throw std::runtime_error("Span calibration out of bounds");r[i]=static_cast<int>(n);
+        }
+        if(r.z<1||r.w<1||r.x+r.z>16384||r.y+r.w>16384)throw std::runtime_error("Invalid span calibration size");
+        result.emplace(name,r);
+    }
+    return result;
+}
+inline const Rects& configured(){
+    static const Rects value=[](){const char* raw=std::getenv("WALLPAPER_LAB_SPAN_LAYOUT");return raw&&*raw?parse(raw):Rects{};}();
+    return value;
+}
+inline glm::ivec4 rect(const std::string& name,const glm::ivec2& position,const glm::ivec2& size){
+    const auto& layout=configured();if(layout.empty())return {position.x,position.y,size.x,size.y};
+    auto found=layout.find(name);if(found==layout.end())throw std::runtime_error("Span calibration missing output: "+name);
+    return found->second;
+}
+}
