+    // Explicit opt-in framebuffer evidence, also usable behind a lock screen.
+    // Normal rendering does not create screenshots or touch this path.
+    if (const char* directory = std::getenv ("WALLPAPER_LAB_SPAN_CAPTURE")) {
+        static std::set<std::string> captured;
+        const auto wallpaper = m_wallpapers.find (viewport->name);
+        if (m_driver.getFrameCounter () >= 120 && !captured.contains (viewport->name)
+            && wallpaper != m_wallpapers.end () && wallpaper->second->isReady ()) {
+            const int width = viewport->viewport.z, height = viewport->viewport.w;
+            if (width > 0 && height > 0 && int64_t (width)*height <= 40000000) {
+                std::vector<unsigned char> pixels (size_t(width)*height*3);
+                glPixelStorei (GL_PACK_ALIGNMENT, 1);
+                glReadPixels (viewport->viewport.x, viewport->viewport.y, width, height, GL_RGB, GL_UNSIGNED_BYTE, pixels.data ());
+                glPixelStorei (GL_PACK_ALIGNMENT, 4);
+                std::string name = viewport->name;
