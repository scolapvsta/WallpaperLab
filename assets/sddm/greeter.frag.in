#version 440
layout(location=0) in vec2 qt_TexCoord0;
layout(location=0) out vec4 fragColor;
layout(std140,binding=0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 imageSize;
    vec2 outputSize;
    vec3 basic;
    vec4 more;
    vec3 geometry;
    vec3 placement;
    float crop;
    vec4 region;
};
layout(binding=1) uniform sampler2D source;
@SDDM_ADJUST_GLSL@
void main() { fragColor = labImage(source,region.xy+qt_TexCoord0*region.zw,imageSize,outputSize,basic,more,geometry,placement,crop,true)*qt_Opacity; }
